# EveSynapse environment (copy to .env or export in your shell)
# The app loads ./.env automatically at startup; real environment
# variables always win over values in the file.

# EVE SSO application credentials — register at https://developers.eveonline.com
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Callback URL registered with the EVE app. Must match the URL in the
# app's settings at developers.eveonline.com character-for-character,
# and is where CCP sends the browser back after login.
EVE_CALLBACK_URL=http://localhost:8080/auth/callback

# Encrypts the EVE login tokens stored in the database, so a copy of
# the database alone cannot be used to act as your characters. Any
# random value of 32+ characters (for example: openssl rand -hex 32).
# The setup script generates one for new server installs. Keep it
# with your backups: without it the stored tokens cannot be read and
# every character has to sign in again. Unset = stored unencrypted.
# TOKEN_ENCRYPTION_KEY=

# PostgreSQL connection URL (the setup script generates one for
# server installs; for local runs, point it at any Postgres 16
# database you have). The schema is created on first boot.
DATABASE_URL=postgres://evesynapse@localhost:5432/evesynapse?sslmode=disable

# Optional overrides
# Listen address. Behind an HTTPS reverse proxy on the same machine,
# use 127.0.0.1:8080 so the app is only reachable through the proxy.
ADDR=:8080

# Which GitHub repo (owner/repo) `evesynapse -update` checks for
# new versions. Leave unset for the mainline repo; set it to your
# fork (e.g. yourname/evesynapse) to update from its releases.
# A fork's releases are signed with the fork's own key, so this only
# works on an install that is already running a build of that fork.
# EVESYNAPSE_UPDATE_REPO=

# Base URL for the EVE static data (SDE) CSV dump the importer
# downloads (Fuzzwork's conversion of CCP's SDE). Point at a mirror
# if needed; a trailing slash is added when missing.
# EVE_SDE_BASE_URL=https://www.fuzzwork.co.uk/dump/latest/csv/

# How CCP can reach whoever runs this instance: an email address, a
# Discord handle or a character name. It is sent in the User-Agent of
# every request to EVE's API, which CCP asks third-party apps to do so
# that a misbehaving one gets a message instead of a block.
# ESI_CONTACT=

# Logging. LOG_LEVEL is the least severe kind of line written: debug,
# info (the default), warn or error. LOG_FORMAT is text (the default)
# or json, one object per line for a log collector.
# LOG_LEVEL=info
# LOG_FORMAT=text

# Who may create an account: comma-separated EVE IDs. With any of
# these set, a new account needs a character that is listed itself
# or whose corporation or alliance is. Leave all three unset and
# anyone who can sign in with EVE can sign up.
# EVE_ALLOWED_CHARACTER_IDS=
# EVE_ALLOWED_CORPORATION_IDS=
# EVE_ALLOWED_ALLIANCE_IDS=

# Administrators: comma-separated EVE character IDs. An account with
# any of these characters linked can open the Admin and Sync pages,
# whichever of its characters is selected. Leave unset and nobody can.
# EVE_ADMIN_CHARACTER_IDS=

# Browser push: notifications from the browser while no EveSynapse
# tab is open. Off until a key pair is set. Make one with
#   evesynapse -push-keys
# and paste the lines it prints here. Keep the private key secret, and
# do not change the pair later: every subscribed browser would have to
# subscribe again. Push needs the site to be served over https.
# After a restart, each browser is switched on by its user under
# bell -> Settings -> "Turn on in this browser", where "Send a test"
# checks it. The README has the full steps ("Notifications and browser
# push").
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.org

# Who may create, change and cancel ops on the calendar: the in-game
# corporation roles, comma separated, spelled as ESI spells them
# (Director, Personnel_Manager, ...). Unset means Director.
# OPS_MANAGER_ROLES=Director

# How often, in seconds, an open page checks whether its notifications
# icon has changed, so new notifications show without a reload. A page
# only checks while it is on screen, and an unchanged icon costs one
# small database read and no page. 0 turns the checks off; other values
# are kept between 5 and 3600. Unset means 30. Restart to apply.
# NOTIFY_POLL_SECONDS=30

# Discord (optional; the README's "Discord" section has the steps).
# The application's id and secret turn on "Connect Discord". The bot
# token lets the bot be added to Discord servers. Keep the secret and
# the token like passwords. What the bot does in each server (roles,
# the ops channel) is not set here: the directors of each corporation
# or alliance choose it on the site.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=

# DEV ONLY: set to 1 to enable the /dev-login route (instant fake
# signed-in session for local development). NEVER enable in production.
# DEV_LOGIN=
